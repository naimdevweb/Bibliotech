APP_NAME="Bibliothèque Municipale"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bibliotheque
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Redis Cache
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@bibliotheque.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:3000

# Sanctum (JWT)
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=database

# Google Books API (optionnel)
GOOGLE_BOOKS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
